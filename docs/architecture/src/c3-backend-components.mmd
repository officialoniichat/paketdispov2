%% C4 Ebene 3 — Komponenten: backend-api (NestJS auf Fastify)
%% Verifiziert gegen apps/backend-api/src/* (app.module.ts, cases/, assignment/, employees/,
%% admin/, prohandel/, workflow/, events/, live/, auth/, prisma/, clock/, dev/, health/, openapi/).
flowchart TB
    classDef ctrl fill:#16314a,stroke:#56b6ff,color:#eef1f6;
    classDef svc fill:#1d222c,stroke:#8b7cf6,color:#eef1f6;
    classDef cross fill:#2a3a2b,stroke:#2dd4a7,color:#eef1f6;
    classDef ext fill:#23272f,stroke:#7c8696,color:#cbd2dd;
    classDef store fill:#3a2b2b,stroke:#f5b955,color:#eef1f6;

    pwa["employee-pwa<br/><i>React-PWA</i>"]:::ext
    web["teamlead-web<br/><i>React-Cockpit</i>"]:::ext
    oidc["OIDC-Provider<br/><i>JWKS</i>"]:::ext
    db[("PostgreSQL")]:::store
    enginePkg["@paket/assignment-engine<br/><i>purer Planer</i>"]:::ext

    subgraph api["Container backend-api"]
        direction TB

        subgraph crosscut["Querschnitt (globale Module)"]
            auth["AuthModule<br/>JwtAuthGuard · RolesGuard<br/>OidcTokenVerifier · Principal"]:::cross
            prisma["PrismaService<br/><i>@Global, $transaction</i>"]:::cross
            events["EventLogService<br/><i>append() · SHA256-Hash-Kette</i>"]:::cross
            workflow["WorkflowService<br/><i>§7.1-Zustandsmaschine transition()</i>"]:::cross
            live["LiveStatusService + LiveController<br/><i>SSE: /api/me/stream, /api/teamlead/stream</i>"]:::cross
            clock["ClockService<br/><i>@Global now(): Dev-Zeit-Override<br/>(AppConfig) oder Systemzeit</i>"]:::cross
        end

        subgraph cases["CasesModule"]
            meCtrl["MeController<br/>POST /api/me/cases/:id/issues/:issueId/reopen (Rückmeldung→wieder offen)<br/>GET /api/me/today · current-bundle<br/>· cases/:id/aggregate · POST next-bundle<br/>· POST park (B4) · POST workstation (A2)"]:::ctrl
            casesCtrl["CasesController<br/>POST /api/cases/:id/start-preparation (auch resume)<br/>· complete (skuQuantities) · partial-complete (Probleme→issue_open, Erst-Meldung = 1. Verlaufs-Eintrag)"]:::ctrl
            tlCtrl["TeamleadController<br/>/api/teamlead/* cases · bundles · dashboards<br/>· GET ablagen (§10.2 vollständiger Pool für die Digitalen Ablagen, ohne Paging)<br/>· assignments/recalculate|preview|export-zst<br/>· cases/:id/return-to-bucher|complete-intake (Intake-Gate D1)<br/>· cases/:id/issues/:issueId/instruction (Instruktion je Meldung; alle instruiert→problem_resolved)<br/>· delivery-groups/merge|split|release (D2)<br/>· cases/lookup (WE-Nr) · cases/search (Suche+Browse im Zuweisen-Flow A1/A2/B1) · cases/:id/flag-attention|unflag-attention<br/>· cases/:id/forward|unforward<br/>· bundles/:id/withdraw|add|reorder|pause|resume · employees/:no/assign<br/>· employees/:no/assign-bundle (A1/A2) · bundles/:id/cases/:caseId/move (B2, optional targetPackIndex)"]:::ctrl
            casesSvc["CasesService<br/><i>getToday (pack-gefiltert) · aggregate · start · complete<br/>· parkRemaining · claimWorkstation</i>"]:::svc
            packWin["pack-window.ts<br/><i>Pack-Fachlogik (rein, single source, PERSISTIERT in AssignmentItem.packIndex):<br/>packWindow (aktives Pack + Anzeige-Mitnahme) · packAdvanceBlockers (Belege mit offenem Problem blockieren NICHT)<br/>· packMembers/packInsertPosition (Ziel-Pack auflösen + hinter dessen letztes Mitglied einsortieren)</i>"]:::svc
            tlSvc["TeamleadService<br/><i>park · prioritize · cancel · withdraw · reorder · exportZst ·<br/>assignToEmployee (newPack = vorgeplantes nächstes Pack im Tages-Bündel, NIE ein Zweit-Bündel)/assignBundleToEmployee (find-or-create) ·<br/>moveCase (B2: anderer MA ODER — mit targetPackIndex — anderes Pack DESSELBEN Bündels;<br/>§7.1-Guard wie withdraw: nur `assigned`, laufende/fertige Arbeit bleibt liegen;<br/>Pack-Ziel → packIndex wird GESCHRIEBEN (nicht nur auditiert) + Einsortieren hinter das letzte Pack-Mitglied,<br/>Resequence Items/Route-Stops)</i>"]:::svc
            tlRead["TeamleadReadService<br/><i>dashboard · board (Packs aus dem persistierten AssignmentItem.packIndex gruppiert — je Pack sein Index<br/>und ob es beim MA gerade aktiv ist · Schichtfenster · Abwesenheit je Zeile) · capacity · kpis · pool (Server-Filter/-Sortierung/-Paging) ·<br/>ablagen (§10.2 VOLLSTÄNDIGER steuerbarer Pool, OHNE Paging — ABLAGEN_WHERE: ready|parked|issue_open + weitergeleitet;<br/>einzige Quelle der Ablagen-Zugehörigkeit) · lookup · search (gerankt, nur zuweisbare) · detail</i>"]:::svc
        end

        subgraph assignment["AssignmentModule"]
            asgSvc["AssignmentService<br/><i>recalculate() (Folge-Packs vorgeplant, NICHT aktiv; räumt nur ENGINE-Platzierungen ab —<br/>AssignmentItem.createdBy=teamlead bleibt stehen, die Automatik plant drumherum;<br/>das angefasste bzw. selbst gezogene AKTIVE Pack ist gesperrt, nur ein unberührtes Starter-Pack wird umgeplant) · preview()<br/>· assignNextBundle() = nächstes Pack: vorgeplantes freischalten, sonst aus dem Pool ziehen</i>"]:::svc
        end

        subgraph empl["EmployeesModule"]
            emplCtrl["EmployeesController<br/>/api/admin/employees (GET·POST·PATCH)<br/>· employees/workstations (GET)<br/>· employees/absences (GET·POST·DELETE — Schichtplan-Kalender: Krank/Urlaub)"]:::ctrl
            emplSvc["EmployeesService<br/><i>list · get · create · updateProfile (skillTier · Workstation)<br/>· materializeShift · listAbsences · createAbsence · deleteAbsence</i>"]:::svc
        end

        subgraph adminMod["AdminModule"]
            adminCtrl["AdminController<br/>/api/admin/locations · /api/admin/rules<br/>· catalogs/wgr · catalogs/inspection-levels<br/>· online-size-preferences (GET·POST·upload)"]:::ctrl
            adminSvc["AdminService<br/><i>RuleConfig (Singleton AppConfig) · Lagerplätze<br/>· Mock-ERP-Kataloge (WGR · Prüfstufen · Online-Größen)</i>"]:::svc
        end

        subgraph problemMod["ProblemReasonsModule"]
            prCtrl["ProblemReasonsController<br/>GET /api/problem-reasons (aktiv, PWA)<br/>· GET·PUT /api/admin/problem-reasons (Katalog-Pflege)"]:::ctrl
            prSvc["ProblemReasonsService<br/><i>admin-verwalteter Problemarten-Katalog<br/>(Replace-all-Upsert; referenzierte Gründe nur deaktivieren)</i>"]:::svc
        end

        subgraph prohandel["ProhandelModule"]
            phCtrl["ProhandelController<br/>POST /api/admin/integrations/prohandel/pull"]:::ctrl
            pictoCtrl["PictogramsController<br/>GET /static/pictograms/:code.svg"]:::ctrl
            phSvc["ProhandelService<br/><i>Mock-Connector (A9): beleg-generator + beleg-persist<br/>(gemeinsame Senke mit prisma/seed.ts)</i>"]:::svc
        end

        subgraph msgs["MessagesModule"]
            msgsCtrl["TeamleadMessagesController · MeMessagesController<br/>POST·GET /api/teamlead/messages (senden · Lesestatus) ·<br/>GET /api/me/messages · POST /api/me/messages/:id/read („Gelesen“-Quittung PWA)"]:::ctrl
            msgsSvc["MessagesService<br/><i>TeamleadMessage (employeeId · caseId? · text · readAt) — §16.1 self-scoped</i>"]:::svc
        end

        subgraph devMod["DevModule (per Env geschaltet: DEV_PANEL, 404 in Prod)"]
            devCtrl["DevController<br/>GET /api/dev/scenarios · POST scenarios/:key/load<br/>· POST scenarios/reset · POST/DELETE time-override<br/>· POST materialize-shifts<br/><i>@Roles(Admin) + DevPanelGuard</i>"]:::ctrl
            scenSvc["ScenarioService<br/><i>Katalog + loadScenario (reset + seed)<br/>src/dev/scenarios/: typisierte Registry B1–B15<br/>(15 Szenarien, definitions/* + CSV-Fixture),<br/>Schicht-Fenster gestern…+13 Tage (Mo–Fr) statt nur Seed-Tag,<br/>Volumen typical/peak/masse (171/315/650 Belege),<br/>auch von prisma/seed.ts + Int-Tests genutzt</i>"]:::svc
        end

        subgraph dom["Fachliche Kerne (src/modules/*)"]
            mods["completion · issue/derive-problems (implizite Probleme)<br/>· print · transport · reporting (CSV)"]:::svc
        end
    end

    pwa -->|"REST + SSE"| meCtrl
    pwa --> casesCtrl
    pwa -->|"Problemarten (aktiv)"| prCtrl
    pwa -->|"Piktogramme"| pictoCtrl
    web -->|"REST + SSE"| tlCtrl
    web --> emplCtrl
    web --> adminCtrl
    web -->|"Problemarten-Katalog"| prCtrl
    web -->|"Jetzt pullen"| phCtrl

    meCtrl --> casesSvc
    casesCtrl --> casesSvc
    tlCtrl --> tlSvc
    tlCtrl --> tlRead
    tlCtrl --> asgSvc
    meCtrl --> asgSvc
    emplCtrl --> emplSvc
    adminCtrl --> adminSvc
    prCtrl --> prSvc
    casesSvc --> prSvc
    casesSvc -->|"was der MA sehen darf"| packWin
    asgSvc -->|"Pull-Guard: nächstes Pack frei?"| packWin
    tlSvc -->|"Ziel-Pack beim Umhängen"| packWin
    phCtrl --> phSvc
    devCtrl --> scenSvc
    devCtrl --> asgSvc
    tlCtrl --> clock
    meCtrl --> clock
    phCtrl --> clock
    devCtrl --> clock

    casesSvc --> workflow
    tlSvc --> workflow
    workflow --> events
    casesSvc --> live
    tlSvc --> live
    asgSvc --> enginePkg
    asgSvc --> events
    phSvc --> events
    tlSvc --> mods

    auth -. "schützt alle Controller" .-> cases
    auth --> oidc
    casesSvc --> prisma
    tlSvc --> prisma
    tlRead --> prisma
    asgSvc --> prisma
    emplSvc --> prisma
    adminSvc --> prisma
    prSvc --> prisma
    phSvc --> prisma
    events --> prisma
    workflow --> prisma
    scenSvc --> prisma
    clock --> prisma
    prisma --> db

    msgsCtrl --> msgsSvc
