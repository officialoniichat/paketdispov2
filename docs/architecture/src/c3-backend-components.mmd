        subgraph collab["CollaborationModule (31.08.2026 — geteilter Beleg)"]
            collabCtrl["CollaborationController<br/><i>@Controller(„api/me“) · Rolle Mitarbeiter</i><br/>GET /api/me/colleagues (aktive Kolleg:innen ohne mich · shiftToday, heute im Dienst zuerst)<br/>· POST /api/me/cases/:caseId/invitations (Einladen — Inhaber oder aktiver Beteiligter; legt die Inhaber-Zeile an, Helfer → eingeladen)<br/>· POST /api/me/invitations/:participantId/respond (annehmen/ablehnen — nur der Eingeladene)<br/>· GET /api/me/nachrichten (Posteingang: Einladungen erhalten/gesendet + Teamlead-Nachrichten, pendingCount)<br/>· POST /api/me/cases/:caseId/part-done („Teilbeleg erledigt“ — eigene Beteiligung → teil_erledigt, bucht nichts)"]:::ctrl
            tlCollabCtrl["TeamleadCollaborationController<br/><i>@Controller(„api/teamlead“) · Rolle Teamleitung/Admin — Fachlogik im TeamleadService,<br/>weil dort die §8.4-Bündel-Mechanik und das Auflösen beim Entziehen leben</i><br/>POST /api/teamlead/cases/:caseId/collaboration (Gemeinsam zuweisen: ≥ 2 Mitarbeiter, der erste bekommt den Beleg in den Karren,<br/>alle Beteiligungen angenommen, ein geparkter Beleg wird freigegeben — Pflicht-Grund)<br/>· POST /api/teamlead/cases/:caseId/participants/:employeeNo/remove (Helfer entfernen, Pflicht-Grund; Inhaber → 409)"]:::ctrl
            collabSvc["CollaborationService<br/><i>Beteiligungen (CaseParticipant) als Overlay — kein zweites AssignmentItem, kein neuer CaseStatus; abgelehnt/entfernt → erneut einladbar ·<br/>Audit case.collaboration_invited/_accepted/_declined/_part_done/_participant_removed ·<br/>Live collaboration.invited (an die Eingeladenen) · collaboration.changed (an Inhaber + Beteiligte, beim Entfernen inkl. dem Entfernten)</i>"]:::svc
            participants["participants.ts<br/><i>reine Prisma-Hilfsfunktionen ohne DI: activeParticipantEmployeeNos · recipientsForCase (Inhaber + aktive Beteiligte = SSE-Empfänger) ·<br/>isCollaborationActive (≥ 1 Helfer angenommen|teil_erledigt) · dissolveCollaborationTx (case.collaboration_dissolved)</i>"]:::svc
        end

        subgraph devMod["DevModule (per Env geschaltet: DEV_PANEL, 404 in Prod)"]
            devCtrl["DevController<br/>GET /api/dev/scenarios · POST scenarios/:key/load<br/>· POST scenarios/reset · POST/DELETE time-override<br/>· POST materialize-shifts<br/><i>@Roles(Admin) + DevPanelGuard</i>"]:::ctrl
