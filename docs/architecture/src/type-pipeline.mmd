%% Typ-Generierungskette — wie domain-types (Zod), Prisma, OpenAPI und api-client zusammenhängen.
%% Verifiziert: packages/domain-types (zod), apps/backend-api/src/openapi/generate.ts (Preview-Modus),
%% apps/backend-api/src/swagger.ts (@nestjs/swagger), package.json-Skripte (openapi:generate),
%% packages/api-client (openapi-typescript -> src/generated/schema.ts, openapi-fetch, openapi-drift.test.ts).
flowchart LR
    classDef src fill:#143a35,stroke:#2dd4a7,color:#eef1f6;
    classDef gen fill:#1d222c,stroke:#8b7cf6,color:#eef1f6;
    classDef artifact fill:#3a2b2b,stroke:#f5b955,color:#eef1f6;
    classDef consumer fill:#16314a,stroke:#56b6ff,color:#eef1f6;

    zod["@paket/domain-types<br/><b>Zod-Schemas — Single Source of Truth</b><br/><i>Enums · RuleConfig · Case-/Position-/SKU-Schemas</i>"]:::src
    prismaSchema["prisma/schema.prisma<br/><i>DB-Modelle</i>"]:::src

    prismaGen["prisma generate"]:::gen
    prismaClient["PrismaClient-Typen<br/><i>(backend-intern)</i>"]:::artifact

    dtos["Backend-DTOs + @nestjs/swagger-Dekoratoren"]:::gen
    openapiGen["openapi:generate<br/><i>src/openapi/generate.ts (NestFactory preview:true, ohne DB)</i>"]:::gen
    openapiJson["openapi.json"]:::artifact

    otsc["api-client: openapi-typescript<br/><i>pnpm --filter @paket/api-client generate</i>"]:::gen
    schemaTs["api-client/src/generated/schema.ts<br/><i>paths · components · operations</i>"]:::artifact
    client["createApiClient() — openapi-fetch<br/><i>+ re-exportiert domain-types</i>"]:::artifact
    drift["openapi-drift.test.ts<br/><i>wacht über Drift zwischen Spec und Generat</i>"]:::gen

    pwa["employee-pwa"]:::consumer
    web["teamlead-web"]:::consumer

    zod --> dtos
    prismaSchema --> prismaGen --> prismaClient
    prismaClient --> dtos
    dtos --> openapiGen --> openapiJson
    zod -. "validiert RuleConfig / Payloads" .-> dtos
    openapiJson --> otsc --> schemaTs --> client
    zod --> client
    client --> pwa
    client --> web
    openapiJson -. "verglichen durch" .-> drift
    schemaTs -. "verglichen durch" .-> drift
