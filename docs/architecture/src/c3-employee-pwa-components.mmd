%% C4 Ebene 3 — Komponenten: employee-pwa (React + Vite PWA)
%% Verifiziert gegen apps/employee-pwa/src/* (screens/, workflow/, data/, routes/) — Tasks 13–17.
%% Der echte Mitarbeiter-Login (data/auth.ts) schützt die App; das Backend ist die einzige
%% Quelle der Wahrheit via React Query plus SSE-Live-Update-Kanal — die früheren Dexie-Module db/
%% (Offline-first-Cache), events/ (lokales Audit-Log) sowie seed/sync/repository sind
%% entfernt (Tasks 10–13). Task 15 ergänzte useLiveUpdates() (GET /api/me/stream, SSE).
flowchart TB
    classDef screen fill:#16314a,stroke:#56b6ff,color:#eef1f6;
    classDef hook fill:#143a35,stroke:#2dd4a7,color:#eef1f6;
    classDef logic fill:#1d222c,stroke:#8b7cf6,color:#eef1f6;
    classDef ext fill:#23272f,stroke:#7c8696,color:#cbd2dd;

    api["backend-api<br/>/api/auth/login · /api/me/today · /aggregate · next-bundle · park<br/>/api/cases/:id/* · /api/issues · /static/pictograms/* · SSE /api/me/stream"]:::ext

    subgraph pwa["Container employee-pwa"]
        direction TB
        subgraph screens["screens/ + components/ (Router: routes/paths.ts, App durch Session geschützt)"]
            login["LoginScreen<br/><i>nur Mitarbeiternummer (kein PIN) → POST /api/auth/login</i>"]:::screen
            home["BundleHomeScreen<br/><i>/ — zeigt NUR das aktive Pack (Pull-Prinzip; Sichtbarkeit UND Aktiv/Mitnahme-Trennung entscheidet das Backend — carriedOver/packOrdinal je Beleg, die App vergleicht keine packIndexe) plus mitgenommene Problem-Belege früherer Packs („aus Pack n“); alle Zähler laufen aufs aktive Pack;<br/>Ware holen inline (je Beleg Kopf-Infos inkl. CatMan-Termin + Barcode-Pop-up) + Bearbeiten (frei wählbar) + Rest parken; Problemfall rot geparkt / grün geklärt;<br/>Anzeige-Sortierung displayRank — BEIDE Abschnitte gleich, Engine-Reihenfolge bleibt Grundlage: alle Meldungen instruiert → ganz OBEN, noch offene Meldung → ganz UNTEN, sonst unverändert;<br/>Meldungs-Badge „nx“ (IssueBadge, components/) statt Symbol — rot/grün/zweigeteilt, Tap/Hover-Popover mit allen Meldungen + Instruktionstext</i>"]:::screen
            barcode["Code128Barcode (components/)<br/><i>WE-Nr als Code-128-SVG im Pop-up (Dialog) — Encoder: domain/code128.ts (pur)</i>"]:::logic
            catManChip["CatManChip (components/)<br/><i>CatMan-Termin als Chip (Kalender-Icon + „CatMan &lt;Datum&gt;“, überschritten rot „überfällig“) — Vergleich gegen den Bezugstag: domain/catMan.ts (pur). Anzeige, KEIN Prioritätstreiber</i>"]:::logic
            process["BelegProcessScreen<br/><i>/case/:id — Beleg-Kopf mit aggregiertem CatMan-Termin; sticky Positions-Tabelle; Kopfzelle stapelt HS/Shop/CatMan/Etage/Filiale/Shopbereich; Etikettpreis mit € + Komma; Problem markiert Größe/ganze POS rot —<br/>auch OFFENE Server-Meldungen färben ihre Position komplett rot;<br/>TL-Hinweis-Block NEBEN den AW-Piktogrammen (PositionIssueBlock, components/): NUR die aktuellste Nachricht<br/>(bei instruierten Meldungen die TL-Instruktion — voller Verlauf nur in der Teamlead-UX) +<br/>„Erneut melden / Rückfrage“ (Pflichttext) → data/useReopenIssue.ts (POST /api/me/cases/:id/issues/:issueId/reopen)</i>"]:::screen
            osk["OnScreenKeyboard (components/, App-mounted)<br/><i>aufklappbare digitale Tastatur für data-osk-Felder; nur Touch, blendet bei Hardware-Tastatur aus</i>"]:::logic
            msgBanner["NachrichtenBanner (components/, App-mounted)<br/><i>Teamlead-Nachricht unter dem Header: anzeigen + „Gelesen“ quittieren<br/>(data/useNachrichten.ts: GET /api/me/messages · POST :id/read, Polling 15 s)</i>"]:::logic
            problemDlg["ProblemDialog<br/><i>Problem je Position/Größe (Katalog-Grund, lokal gesammelt)</i>"]:::screen
            teilDlg["TeilabschlussDialog<br/><i>Zusammenfassung aller Probleme → an Teamleitung</i>"]:::screen
        end
        subgraph wf["workflow/ (reine Logik + der einzige Live-Daten-Hook)"]
            useCaseFlow["useCaseFlow()<br/><i>togglePositionChecked · setSkuQuantity · setCorrectedVkPrice · addProblem/removeProblem · complete · partialComplete</i>"]:::hook
            model["workflowModel.ts<br/><i>Guards: canCompleteCase (Problem sperrt) · hasAnyProblem · skuQuantitiesBody · problemsBody</i>"]:::logic
        end
        subgraph data["data/ (React Query — das Backend ist die einzige Quelle der Wahrheit)"]
            apiClient["api.ts → @paket/api-client<br/><i>getApiClient() — frischer Client je Aufruf, aktuelles Session-Token</i>"]:::logic
            auth["auth.ts · session.ts<br/><i>login()/logout() · JWT-Claims · onSessionCleared()</i>"]:::logic
            meToday["useMeToday() · useReferenceDay() · useNextBundle() · useParkRemaining()<br/><i>GET/POST /api/me/* — queryKey ['me','today']; useReferenceDay() = Server-Tag der Termin-Vergleiche</i>"]:::hook
            caseAgg["useCaseAggregate()<br/><i>GET /api/me/cases/:id/aggregate — queryKey ['me','case',id,'aggregate']</i>"]:::hook
            reasons["useProblemReasons()<br/><i>GET /api/problem-reasons — dynamischer Problemarten-Katalog</i>"]:::hook
            mapper["caseAggregateMapper.ts<br/><i>CaseAggregateDto → CaseAggregate (domain/types.ts)</i>"]:::logic
            persist["persist.ts<br/><i>persistStartPreparation/Complete/PartialComplete — einfacher POST, wirft bei Fehler</i>"]:::logic
            focus["useFocusRefresh.ts<br/><i>invalidateQueries(['me','today']) bei Fenster-Fokus</i>"]:::hook
            live["useLiveUpdates.ts<br/><i>EventSource /api/me/stream?token= — bei Message: invalidateQueries(['me','today'])</i>"]:::hook
        end
    end

    login --> auth
    auth --> apiClient
    home --> meToday
    home --> barcode
    home --> catManChip
    catManChip --> meToday
    process --> catManChip
    process --> useCaseFlow
    process --> problemDlg
    process --> teilDlg
    login -->|"data-osk"| osk
    process -->|"data-osk"| osk
    problemDlg -->|"data-osk"| osk
    problemDlg --> reasons
    useCaseFlow --> model
    useCaseFlow --> caseAgg
    useCaseFlow --> persist
    reasons --> apiClient
    caseAgg --> mapper
    caseAgg --> apiClient
    meToday --> apiClient
    persist --> apiClient
    focus --> meToday
    live --> meToday
    live -->|"SSE (JWT als Query-Param)"| api
    process -->|"Piktogramm-Bild"| api
    apiClient -->|"REST (Bearer-JWT)"| api
